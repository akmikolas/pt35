# /etc/pt35.conf —— PocketTerm35 本地配置
#
# 复制到 /etc/pt35.conf 后按需修改：
#   sudo install -m644 pt35.conf.example /etc/pt35.conf
#
# 本文件被以下命令读取（都可被环境变量覆盖）：
#   wifi       静态 IP / 网关 / DNS
#   temp       温度告警阈值、风扇引脚
#   pt35-motd  主机名显示、额外服务监控
#
# ⚠️ 这个文件里有你的网络信息，不要提交到 git！

# ── 网络（wifi static 用）───────────────────────────────────
STATIC_IP=192.168.1.100/24
STATIC_GW=192.168.1.1
DNS_LIST="223.5.5.5 1.1.1.1"

# ── 温度（temp 与风扇控制）──────────────────────────────────
# 风扇是 PWM 软件控制（GPIO14），实测 GPIO14 无硬件 PWM
FAN_GPIO=14
TEMP_WARN=55        # 超过此温度显示黄色
TEMP_CRIT=65        # 超过此温度显示红色

# ── 欢迎页（pt35-motd）─────────────────────────────────────
# 额外要监控的服务（空格分隔，会显示在服务状态行）
EXTRA_SERVICES=""
